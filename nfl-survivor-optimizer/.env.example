# ---------------------------------------------------------------------------
# NFL Survivor Optimizer — environment
# Copy to .env.  Every key below is OPTIONAL except DATABASE_URL.
# The app runs in a reduced (clearly-labelled) mode when a provider is missing.
# API keys are read only in server-side code and are never sent to the browser.
# ---------------------------------------------------------------------------

# Required. Local SQLite file used by Prisma.
DATABASE_URL="file:./dev.db"

# Optional. The Odds API (https://the-odds-api.com) — live multi-book moneylines.
# Without it the app falls back to the reference moneylines shipped with the
# nflverse schedule and marks the odds provider as DEGRADED.
ODDS_API_KEY=""

# Optional. SportsDataIO (https://sportsdata.io) — richest injury + depth chart feed.
SPORTSDATAIO_API_KEY=""

# Optional. Sleeper needs no key; set to 0 to disable the free injury fallback.
ENABLE_SLEEPER_FALLBACK="1"

# Optional. Open-Meteo needs no key; set to 0 to disable weather entirely.
ENABLE_WEATHER="1"

# Optional. Season the app operates on.
NFL_SEASON="2026"

# Optional. Pin "today" for demos/tests, e.g. "2026-10-14T12:00:00Z".
APP_CLOCK=""

# Optional. Set to 1 to forbid all outbound network calls (tests / airplane mode).
# The app then serves only what is already in SQLite and the local cache.
OFFLINE_MODE="0"
