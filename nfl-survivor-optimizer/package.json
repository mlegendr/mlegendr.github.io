{
  "name": "nfl-survivor-optimizer",
  "version": "1.0.0",
  "private": true,
  "description": "Survivor / Last Man Standing pool optimizer for the 2026 NFL regular season.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "predev": "npm run db:setup && tsx scripts/ensure-seeded.ts",
    "dev": "next dev",
    "prebuild": "node scripts/ensure-env.mjs && prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "node scripts/ensure-env.mjs && prisma generate",
    "db:push": "node scripts/ensure-env.mjs && prisma db push --skip-generate",
    "db:setup": "node scripts/ensure-env.mjs && prisma generate && prisma db push --skip-generate --accept-data-loss",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "rm -f prisma/dev.db && npm run db:setup && npm run db:seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "train": "python3 scripts/train_model.py",
    "backtest": "python3 scripts/backtest.py",
    "survivor-backtest": "python3 scripts/survivor_backtest.py",
    "verify": "npm run typecheck && npm run test && npm run build",
    "prestart": "npm run db:setup && tsx scripts/ensure-seeded.ts",
    "env:setup": "node scripts/ensure-env.mjs",
    "pretest": "node scripts/ensure-env.mjs && prisma generate",
    "postinstall": "node scripts/check-native-deps.mjs",
    "pool-equity-backtest": "python3 scripts/pool_equity_backtest.py"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "^15.5.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "^15.5.25",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
